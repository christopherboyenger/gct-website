{
  "framework": null,
  "buildCommand": "node scripts/build-season.mjs",
  "outputDirectory": "season-dist",
  "installCommand": null,
  "redirects": [
    {
      "source": "/creators",
      "destination": "/#creators",
      "permanent": false
    },
    {
      "source": "/brands",
      "destination": "/#brands",
      "permanent": false
    },
    {
      "source": "/gct-brands.html",
      "destination": "/#brands",
      "permanent": false
    },
    {
      "source": "/gct-brands-network.html",
      "destination": "/#brands",
      "permanent": false
    },
    {
      "source": "/gct-landing.html",
      "destination": "/#creators",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|appfavicon[.]jpg$|logo-gct-full[.]png$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https://qvuqjpcxnnikbigixupb.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action https://qvuqjpcxnnikbigixupb.supabase.co"
        }
      ]
    },
    {
      "source": "/((?!assets/|appfavicon[.]jpg$|logo-gct-full[.]png$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
