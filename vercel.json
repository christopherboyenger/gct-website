{
  "framework": null,
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "site-dist",
  "installCommand": null,
  "redirects": [
    {
      "source": "/gct-entry.html",
      "destination": "/creators",
      "permanent": true
    },
    {
      "source": "/gct-landing.html",
      "destination": "/creators",
      "permanent": true
    },
    {
      "source": "/gct-network.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/gct-brands.html",
      "destination": "/brands",
      "permanent": true
    },
    {
      "source": "/gct-brands-network.html",
      "destination": "/brands",
      "permanent": true
    },
    {
      "source": "/gct-courses.html",
      "destination": "/courses-experiences",
      "permanent": true
    },
    {
      "source": "/courses",
      "destination": "/courses-experiences",
      "permanent": true
    },
    {
      "source": "/gco-sponsor-deck.html",
      "destination": "/brands",
      "permanent": true
    },
    {
      "source": "/gct-creators.html",
      "destination": "/creators",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/creators",
      "destination": "/gct-creators.html"
    },
    {
      "source": "/brands",
      "destination": "/gct-brands.html"
    },
    {
      "source": "/courses-experiences",
      "destination": "/gct-courses.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; media-src 'self'; connect-src 'self' https://qvuqjpcxnnikbigixupb.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action https://qvuqjpcxnnikbigixupb.supabase.co"
        }
      ]
    }
  ],
  "cleanUrls": false
}
