{
  "framework": null,
  "buildCommand": "node scripts/build-season.mjs",
  "outputDirectory": "season-dist",
  "installCommand": null,
  "redirects": [
    {
      "source": "/creators",
      "destination": "/#creators",
      "permanent": false
    },
    {
      "source": "/brands",
      "destination": "/#brands",
      "permanent": false
    },
    {
      "source": "/gct-brands.html",
      "destination": "/#brands",
      "permanent": false
    },
    {
      "source": "/gct-brands-network.html",
      "destination": "/#brands",
      "permanent": false
    },
    {
      "source": "/gct-landing.html",
      "destination": "/#creators",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/preview",
      "destination": "/api/preview?page=network"
    },
    {
      "source": "/preview/creators",
      "destination": "/api/preview?page=creators"
    },
    {
      "source": "/preview/brands",
      "destination": "/api/preview?page=brands"
    },
    {
      "source": "/preview/courses",
      "destination": "/api/preview?page=courses"
    },
    {
      "source": "/preview/events",
      "destination": "/api/preview?page=events"
    },
    {
      "source": "/preview/:path*",
      "destination": "/api/preview?page=missing"
    },
    {
      "source": "/((?!api/|assets/|appfavicon[.]jpg$|logo-gct-full[.]png$|The%20Golf%20Creator%20Tour%20logo[.]png$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!assets/|appfavicon[.]jpg$|logo-gct-full[.]png$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https://qvuqjpcxnnikbigixupb.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://qvuqjpcxnnikbigixupb.supabase.co"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https://qvuqjpcxnnikbigixupb.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://qvuqjpcxnnikbigixupb.supabase.co"
        }
      ]
    }
  ],
  "functions": {
    "api/preview.js": {
      "includeFiles": "gct-{network,creators,brands,courses,events}.html",
      "maxDuration": 10
    }
  }
}
